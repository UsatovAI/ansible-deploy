# Human-provided .env data. Fill these BEFORE running `make secrets`.
vps_ansible_user: "root"        # sudo/ssh user on the target VPS
vps_ansible_password: ""        # ssh + sudo password for the target VPS

# The site role does not require anything below this line.
claude_code_oauth_token: ""    # output of `claude setup-token`, run locally by a human who is already authenticated
jira_site_url: ""               # e.g. https://usatovpavel.atlassian.net
jira_email: ""
jira_api_token: ""
github_pat: ""                  # fine-grained PAT scoped to what the deployed MCP needs
site_domain_or_port:
  port: 80

# Login password for the claude-web-console chat UI (deploy-site / AGENT-32's
# actual "site"). PBKDF2-hashed at rest by bootstrap.sh -- this plaintext
# only ever exists here (vault-encrypted) and briefly in Ansible's own
# variable resolution when the playbook runs.
console_login_password: ""
console_admin_email: ""         # used only for Let's Encrypt cert registration

# Only needed for claudeweb_console.yml (make claudeweb-full / claudeweb-env).
# Full contents of the LIVE claudeweb daemon's own credential file
# (config.yaml's daemon_env_file, currently /home/claudeweb/env/.env) --
# what claudeweb itself uses for VPS/GitHub work it does unattended, e.g.
# self-redeploy or opening a PR. Matches /home/claudeweb/env/.env.example's
# schema. Leave a key blank to skip writing it; `make claudeweb-env` also
# accepts one-off KEY=VALUE pairs for a partial update without listing all
# of these.
#
# NOT listed here: CLAUDE_CODE_OAUTH_TOKEN and GHP_KEY. claudeweb_console.yml
# always derives those from claude_code_oauth_token and github_pat above --
# the same values root already uses, one source of truth, not a second
# field to keep in sync. If claudeweb ever genuinely needs different
# credentials from root's, that's a deliberate change to
# claudeweb_console.yml's vars block, not a value to fill in here.
claudeweb_daemon_env:
  VPS_HOST: ""
  VPS_USER: "root"
  VPS_PASSWORD: ""
  VPS_PORT: "22"
  GITHUB_PASSWORD: ""
  GITHUB_ACCOUNT: "UsatovAI"
  ANTHROPIC_API_KEY: ""        # only if claudeweb ever moves off setup-token auth; currently unused, see daemon/claude_daemon.py
